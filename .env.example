# Poursona environment variables
# Copy this file to .env.local and fill in your values.
# Variables marked [REQUIRED] will cause immediate runtime failures if missing.
# Variables marked [RECOMMENDED] degrade specific features if missing.
# Variables marked [OPTIONAL] are additive (monitoring, etc.).

# ── AI ────────────────────────────────────────────────────────────────────────
# [REQUIRED] Used by /api/chat and /api/menu-scan.
# Missing: all AI chat and menu extraction calls throw immediately.
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED] Neon PostgreSQL connection string. Set both; lib/db.ts tries each.
# Missing: every API route that touches the DB fails with a connection error.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
POSTGRES_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# [REQUIRED] Clerk authentication. Admin, poursona-admin, QR, and menu-scan
# routes all require a valid Clerk session. Missing: all protected routes 401.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk redirect URLs — must match Clerk dashboard settings.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Stripe ────────────────────────────────────────────────────────────────────
# [REQUIRED] All three values must be present and consistent for billing to work.
# STRIPE_SECRET_KEY missing: /api/stripe/checkout and /api/stripe/portal throw.
# STRIPE_WEBHOOK_SECRET missing or wrong: webhook signature fails → subscription
#   status never updates after checkout. Vendors will pay but stay on "trial".
# STRIPE_PRICE_ID missing or invalid: checkout session creation fails with
#   Stripe API error. Use the live price ID from your Stripe dashboard.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Also register the webhook endpoint in Stripe dashboard:
#   URL: https://your-domain.com/api/stripe/webhook
#   Events: checkout.session.completed, customer.subscription.updated,
#           customer.subscription.deleted

# ── App URL ───────────────────────────────────────────────────────────────────
# [REQUIRED] Used in all outbound email links (order confirmation, vendor invite,
# trial warning) and in CSRF origin checking. Must match your live domain exactly.
# Missing or wrong: email links point to the wrong domain; CSRF guard may reject
# legitimate requests from production.
NEXT_PUBLIC_APP_URL=https://pour-sona.com

# ── App secret ────────────────────────────────────────────────────────────────
# [RECOMMENDED] Used as HMAC seed for internal operations. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=your-random-secret-string-here

# ── Email (Resend) ────────────────────────────────────────────────────────────
# [REQUIRED] Used for: vendor invite, order confirmation, order alert to venue,
# trial expiring warning, trial expired notice.
# Missing: all emails fail silently (logged + Sentry). No guest-facing crash,
# but vendors never receive invites and order alerts are lost.
RESEND_API_KEY=re_...

# ── Rate limiting (Upstash Redis) ─────────────────────────────────────────────
# [REQUIRED] Used to rate-limit /api/chat (20 req/hr per IP). The limiter is
# fail-CLOSED: if Redis is unreachable, /api/chat returns 429 for all requests.
# Missing or wrong: /api/chat is completely blocked in production.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Onboarding secret ─────────────────────────────────────────────────────────
# [REQUIRED for CLI onboarding] Protects /api/onboarding/* from unauthenticated
# script access. The Poursona admin UI authenticates via Clerk; this secret is
# only for server-to-server or CLI calls without a Clerk session.
# SERVER-SIDE ONLY — never use NEXT_PUBLIC_ prefix for this value.
# Missing: CLI/script onboarding returns 401; admin UI onboarding (Clerk-authed)
# still works normally.
POURSONA_ONBOARD_SECRET=your-random-secret-here

# ── Sentry (error tracking) ───────────────────────────────────────────────────
# [OPTIONAL but strongly recommended in production] Without this, runtime errors
# in email helpers and API routes are only logged to server stdout — no alerts,
# no grouped error tracking, no context on who was affected.
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=poursona
SENTRY_AUTH_TOKEN=sntrys_...
