# Poursona environment variables
# Copy this file to .env.local and fill in your values.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Neon / Postgres
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
POSTGRES_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=your-random-secret-string-here

# Temporary Supabase support
# Still used by onboarding's extract-brand-colors function until that code is moved.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
